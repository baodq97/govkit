<?xml version="1.0" encoding="utf-8"?>
<Entity name="WorkOrder" schema="fo_workorder" package="addon" version="1.4.0">
  <Display>Work Order</Display>
  <Labels>
    <Label lcid="1033" value="WorkOrder" />
    <Label lcid="1066" value="WorkOrder (vi)" />
    <Label lcid="1036" value="WorkOrder (fr)" />
  </Labels>
  <Attributes>
      <Attribute name="Name" type="string" required="false" />
      <Attribute name="Owner" type="lookup" target="Employee" required="false" />
      <Attribute name="Cost" type="decimal" required="false" />
      <Attribute name="CostCentre" type="lookup" target="CostCentre" required="false" />
    <Attribute name="fo_createdon" type="datetime" required="false" platform="true" />
    <Attribute name="fo_modifiedon" type="datetime" required="false" platform="true" />
    <Attribute name="fo_versionnumber" type="bigint" required="false" platform="true" />
  </Attributes>
  <Relationships>
    <Relationship name="fo_workorder_owner" type="many-to-one" target="Employee" />
    <Relationship name="fo_workorder_costcentre" type="many-to-one" target="CostCentre" />
  </Relationships>
  <Forms>
    <Form name="main" layout="two-column" formid="{form-workorder-0001}">
      <Section label="General" columns="2">
        <Field name="Name" width="100" />
        <Field name="Owner" width="115" />
        <Field name="Cost" width="130" />
        <Field name="CostCentre" width="145" />
      </Section>
    </Form>
  </Forms>
</Entity>
